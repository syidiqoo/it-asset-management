# Koneksi database PostgreSQL (Neon / Vercel Postgres).
# Gunakan endpoint "pooled" untuk runtime aplikasi di Vercel.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Opsional: koneksi langsung (tanpa pooler) khusus untuk menjalankan migrasi
# (`prisma migrate`). Kalau tidak diisi, migrasi memakai DATABASE_URL.
# DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Token Vercel Blob untuk menyimpan gambar & dokumen aset.
# Di Vercel otomatis terisi begitu Blob store dihubungkan ke project.
# Untuk lokal, ambil dengan: vercel env pull
BLOB_READ_WRITE_TOKEN=""
