# Variabel untuk menjalankan aplikasi di komputer (npm run dev / npm run build).
# Untuk deploy di server, lihat .env.docker.example.

# Koneksi PostgreSQL.
DATABASE_URL="postgresql://itasset:password@localhost:5432/itasset"

# Opsional: koneksi khusus untuk migrasi, kalau berbeda dari DATABASE_URL.
# DIRECT_URL="postgresql://itasset:password@localhost:5432/itasset"

# Cookie sesi hanya dikirim lewat HTTPS. Set false kalau memakai HTTP.
# (Kalau tidak diisi: otomatis true saat NODE_ENV=production.)
COOKIE_SECURE=false
