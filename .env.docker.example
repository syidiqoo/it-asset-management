# Variabel untuk `docker compose` di server.
# Di server, salin file ini menjadi .env:
#   cp .env.docker.example .env
# lalu sesuaikan nilainya.

POSTGRES_USER=itasset

# PENTING: gunakan karakter alfanumerik saja (tanpa @ : / ? # &),
# karena nilai ini dirangkai menjadi DATABASE_URL.
POSTGRES_PASSWORD=ganti-dengan-password-kuat

POSTGRES_DB=itasset

# Port yang dibuka di server. Isi 80 kalau ingin diakses tanpa :3000.
APP_PORT=3000

# false = diakses lewat HTTP biasa (mis. http://10.0.0.5:3000)
# true  = diakses lewat HTTPS
COOKIE_SECURE=false
